# Latent.pk environment variables

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Redis (optional — if not set, falls back to in-memory cache)
# Required for multi-instance production deployments
REDIS_URL=redis://localhost:6379

# Cron endpoint auth (optional — required if exposing /api/cron/check-tp-sl publicly)
# Generate a random string: openssl rand -hex 32
CRON_SECRET=

# AskAnalyst.com.pk upstream (used by /api/psx/* proxy routes)
# No auth required — public API
ASKANALYST_BASE_URL=https://api.askanalyst.com.pk

# Investify.pk scraper (used by /api/scrape/* routes)
# No auth required — public website
INVESTIFY_NEWS_URL=https://www.investify.pk/news
INVESTIFY_ANNOUNCEMENTS_URL=https://www.investify.pk/announcements

# Z.AI SDK (used by /api/llm/* routes)
# Reads from /etc/.z-ai-config in sandbox; for production, set up your own Z.ai account
# Or swap to self-hosted Ollama (see README.md → "Production Ollama setup")

# Ollama (optional — only if swapping GLM-4 for self-hosted LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Broker API (pending — replace stubs in /api/execute when credentials arrive)
BROKER_SINGULAR_API_KEY=
BROKER_ARIF_HABIB_API_KEY=
BROKER_FOUNDATION_API_KEY=
