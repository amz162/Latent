// Latent.pk — Prisma schema
// SQLite for MVP; swap to Postgres for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  riskProfile  RiskProfile?
  plans        Plan[]
  trades       Trade[]
}

model RiskProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1-10 score from onboarding questionnaire
  riskTolerance     Int
  // years
  timeHorizon       Int
  // PKR per month
  monthlyContribution Int
  // e.g. "House down payment", "Kid's education", "Retirement"
  goalLabel         String
  goalTargetAmount  Int    // PKR
  goalDate          DateTime
  // computed at onboarding: conservative | moderate | growth | aggressive
  profileBucket     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Plan {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON string: array of { symbol, name, allocationPct, horizon, thesis }
  allocation      String
  // JSON string: array of { month, amount, instructions }
  entryLadder     String
  rebalancingRules String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Trade {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId      String
  symbol        String
  direction     String    // LONG | SHORT
  horizon       String    // DAY | SWING | DIVIDEND | GROWTH
  entryPrice    Float
  exitPrice     Float?
  entryDate     DateTime  @default(now())
  exitDate      DateTime?
  status        String    // OPEN | CLOSED_WIN | CLOSED_LOSS | CLOSED_BREAKEVEN
  pnlPct        Float?
  pnlPkr        Float?
  // for accuracy report
  timeToCloseDays Int?
}

// ─────────────────────────────────────────────────────────────────────
// PSX market backup — synced from psxdata-api.fastapicloud.dev
// ─────────────────────────────────────────────────────────────────────

model Sector {
  // psxdata sector_code (e.g. "0801" = AUTOMOBILE ASSEMBLER)
  code         String   @id
  name         String
  advance      Int      @default(0)
  decline      Int      @default(0)
  unchanged    Int      @default(0)
  turnover     Float?
  marketCapB   Float?
  // full sync metadata
  lastSyncedAt DateTime @default(now())

  stocks       Stock[]
}

model Stock {
  // PSX symbol (e.g. "ENGRO", "OGDC", "HBLTFC2")
  symbol       String   @id
  // display name (currently same as symbol; can be enriched from askanalyst later)
  name         String   @default("")
  sectorCode   String?
  sector       Sector?  @relation(fields: [sectorCode], references: [code])
  // "ALLSHR" | "KMI30" | "KSE100" | "KSE30" etc.
  listedIn     String?
  // backup quote snapshot fields (from screener/quote at last sync)
  price        Float?
  marketCap    Float?
  peRatio      Float?
  divYield     Float?
  freeFloat    Float?
  volume30d    Float?
  change1yPct  Float?
  ldcp         Float?
  change       Float?
  changePct    Float?
  // sync metadata
  source       String   @default("psxdata") // psxdata | askanalyst | manual
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  snapshots    StockSnapshot[]

  @@index([sectorCode])
  @@index([listedIn])
}

model StockSnapshot {
  // time-series of quotes for tracking drift / accuracy
  id           String   @id @default(cuid())
  symbol       String
  stock        Stock    @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  price        Float?
  marketCap    Float?
  peRatio      Float?
  divYield     Float?
  change       Float?
  changePct    Float?
  volume30d    Float?
  capturedAt   DateTime @default(now())

  @@index([symbol])
  @@index([capturedAt])
}
