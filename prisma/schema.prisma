// Latent.pk — Prisma schema
// SQLite for MVP; swap to Postgres for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  riskProfile  RiskProfile?
  plans        Plan[]
  trades       Trade[]
}

model RiskProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1-10 score from onboarding questionnaire
  riskTolerance     Int
  // years
  timeHorizon       Int
  // PKR per month
  monthlyContribution Int
  // e.g. "House down payment", "Kid's education", "Retirement"
  goalLabel         String
  goalTargetAmount  Int    // PKR
  goalDate          DateTime
  // computed at onboarding: conservative | moderate | growth | aggressive
  profileBucket     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Plan {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON string: array of { symbol, name, allocationPct, horizon, thesis }
  allocation      String
  // JSON string: array of { month, amount, instructions }
  entryLadder     String
  rebalancingRules String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Trade {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId      String
  symbol        String
  direction     String    // LONG | SHORT
  horizon       String    // DAY | SWING | DIVIDEND | GROWTH
  entryPrice    Float
  exitPrice     Float?
  entryDate     DateTime  @default(now())
  exitDate      DateTime?
  status        String    // OPEN | CLOSED_WIN | CLOSED_LOSS | CLOSED_BREAKEVEN
  pnlPct        Float?
  pnlPkr        Float?
  // for accuracy report
  timeToCloseDays Int?
}
